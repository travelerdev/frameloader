{
  "name": "frameloader-desktop",
  "productName": "Frameloader",
  "version": "0.0.1",
  "description": "Drop an APK, Windows app, or Linux build onto your Steam Frame and it shows up in your Steam library.",
  "license": "MIT",
  "author": "Zack <zack@traveler.dev>",
  "private": true,
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.cjs",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --config electron-builder.config.cjs --linux --x64 --arm64 --publish never",
    "screenshots": "pnpm build && electron scripts/screenshot.cjs"
  },
  "devDependencies": {
    "frameloader-tokens": "workspace:*",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/yauzl": "^2.10.3",
    "app-info-parser": "^1.1.6",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "multicast-dns": "^7.2.5",
    "ssh2": "^1.17.0",
    "typescript": "^7.0.2",
    "yauzl": "^3.2.0"
  },
  "homepage": "https://www.frameloader.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/travelerdev/frameloader.git",
    "directory": "apps/desktop"
  },
  "dependencies": {}
}
